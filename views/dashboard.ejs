<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TimeWall Micro-Task & Offerwall Hub</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen font-sans">

  <!-- Top Navigation -->
  <header class="bg-slate-800 border-b border-slate-700 sticky top-0 z-50">
    <div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between">
      <div class="flex items-center space-x-2">
        <span class="bg-emerald-500 text-slate-950 font-extrabold px-2.5 py-1 rounded text-lg">TW</span>
        <h1 class="text-xl font-bold tracking-wide">TimeWall <span class="text-emerald-400 text-sm font-normal">Earn & Advertise</span></h1>
      </div>
      <% if (user) { %>
        <div class="flex items-center space-x-4">
          <div class="bg-slate-900 px-3 py-1.5 rounded-lg border border-slate-700 text-sm">
            Balance: <span id="userBalance" class="text-emerald-400 font-bold"><%= user.points_balance %></span> pts
            <span class="text-xs text-slate-400">($<%= (user.points_balance / 10000).toFixed(3) %>)</span>
          </div>
          <div class="bg-slate-900 px-3 py-1.5 rounded-lg border border-slate-700 text-sm hidden sm:block">
            Ad Credits: <span class="text-amber-400 font-bold"><%= user.advertiser_balance %></span> pts
          </div>
          <a href="/logout" class="text-xs bg-rose-600 hover:bg-rose-500 px-3 py-2 rounded font-semibold">Logout</a>
        </div>
      <% } %>
    </div>
  </header>

  <main class="max-w-6xl mx-auto px-4 py-8">
    <% if (!user) { %>
      <!-- Login / Register Card -->
      <div class="max-w-md mx-auto bg-slate-800 p-6 rounded-xl border border-slate-700 shadow-lg mt-10">
        <h2 class="text-2xl font-bold mb-2 text-center text-emerald-400">Start Earning Crypto</h2>
        <p class="text-slate-400 text-sm text-center mb-6">Complete surveys, micro-tasks, and PTC clicks for instant FaucetPay USDT payouts.</p>
        <form action="/auth" method="POST" class="space-y-4">
          <div>
            <label class="block text-xs uppercase text-slate-400 mb-1">Email Address</label>
            <input type="email" name="email" required class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2.5 text-sm focus:border-emerald-500 focus:outline-none">
          </div>
          <div>
            <label class="block text-xs uppercase text-slate-400 mb-1">Password</label>
            <input type="password" name="password" required class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2.5 text-sm focus:border-emerald-500 focus:outline-none">
          </div>
          <div>
            <label class="block text-xs uppercase text-slate-400 mb-1">FaucetPay Email / USDT Address (Optional)</label>
            <input type="text" name="faucetpay_address" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2.5 text-sm focus:border-emerald-500 focus:outline-none">
          </div>
          <button type="submit" class="w-full bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold py-2.5 rounded-lg transition">Login / Create Instant Account</button>
        </form>
      </div>
    <% } else { %>

      <!-- Active PTC Timer Bar (Appears when user clicks a PTC Ad) -->
      <div id="ptcTimerBox" class="hidden mb-6 bg-amber-500/10 border border-amber-500 text-amber-300 p-4 rounded-xl flex items-center justify-between">
        <div>
          <span class="font-bold">PTC Timer Running:</span> Keep the advertiser tab open! Remaining: <span id="ptcCountdown" class="font-extrabold text-xl">15</span>s
        </div>
        <button id="ptcClaimBtn" onclick="claimPtcReward()" class="hidden bg-emerald-500 text-slate-950 font-bold px-4 py-1.5 rounded-lg">Claim Points</button>
      </div>

      <!-- Navigation Tabs -->
      <div class="flex flex-wrap gap-2 mb-6 border-b border-slate-700 pb-3">
        <button onclick="showTab('ptc')" class="tab-btn bg-emerald-500 text-slate-950 font-bold px-4 py-2 rounded-lg text-sm">1. PTC Clicks (<%= ptcAds.length %>)</button>
        <button onclick="showTab('tasks')" class="tab-btn bg-slate-800 hover:bg-slate-700 px-4 py-2 rounded-lg text-sm font-semibold">2. Micro-Tasks (<%= microTasks.length %>)</button>
        <button onclick="showTab('offerwalls')" class="tab-btn bg-slate-800 hover:bg-slate-700 px-4 py-2 rounded-lg text-sm font-semibold">3. Survey Offerwalls</button>
        <button onclick="showTab('advertise')" class="tab-btn bg-slate-800 hover:bg-slate-700 px-4 py-2 rounded-lg text-sm font-semibold">4. Advertise & Review Proofs</button>
        <button onclick="showTab('withdraw')" class="tab-btn bg-slate-800 hover:bg-slate-700 px-4 py-2 rounded-lg text-sm font-semibold">5. Instant Withdraw</button>
      </div>

      <!-- TAB 1: PTC ADS -->
      <div id="tab-ptc" class="tab-content grid md:grid-cols-2 gap-4">
        <% if (ptcAds.length === 0) { %>
          <div class="col-span-2 bg-slate-800 p-6 rounded-xl text-center text-slate-400">You have clicked all available PTC ads for today! Check back soon.</div>
        <% } %>
        <% ptcAds.forEach(ad => { %>
          <div id="ad-card-<%= ad.id %>" class="bg-slate-800 border border-slate-700 p-5 rounded-xl flex flex-col justify-between">
            <div>
              <div class="flex justify-between items-start mb-2">
                <h3 class="font-bold text-lg text-white"><%= ad.title %></h3>
                <span class="bg-emerald-500/20 text-emerald-400 text-xs font-bold px-2.5 py-1 rounded">+<%= ad.reward_points %> pts</span>
              </div>
              <p class="text-slate-400 text-sm mb-4"><%= ad.description || 'Visit advertiser website and wait for the timer to finish.' %></p>
            </div>
            <div class="flex items-center justify-between border-t border-slate-700 pt-3">
              <span class="text-xs text-slate-400">Timer: <%= ad.timer_seconds %> seconds</span>
              <button onclick="startPtc(<%= ad.id %>, '<%= ad.url %>', <%= ad.timer_seconds %>)" class="bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold px-4 py-1.5 rounded-lg text-sm">View Ad</button>
            </div>
          </div>
        <% }) %>
      </div>

      <!-- TAB 2: MICRO-TASKS -->
      <div id="tab-tasks" class="tab-content hidden space-y-4">
        <% microTasks.forEach(task => { %>
          <div class="bg-slate-800 border border-slate-700 p-5 rounded-xl">
            <div class="flex justify-between items-center mb-2">
              <h3 class="font-bold text-lg text-emerald-400"><%= task.title %></h3>
              <span class="bg-emerald-500 text-slate-950 font-extrabold px-3 py-1 rounded text-sm">+<%= task.reward_points %> Points</span>
            </div>
            <p class="text-sm text-slate-300 whitespace-pre-line mb-3"><%= task.instructions %></p>
            <p class="text-xs text-amber-400 mb-4">Required Proof: <%= task.proof_required %></p>
            <form action="/api/tasks/submit" method="POST" class="grid sm:grid-cols-3 gap-3 bg-slate-900 p-3 rounded-lg">
              <input type="hidden" name="task_id" value="<%= task.id %>">
              <input type="text" name="proof_text" required placeholder="Enter username / proof text..." class="bg-slate-800 border border-slate-700 rounded px-3 py-2 text-sm">
              <input type="url" name="screenshot_url" placeholder="Screenshot link (ImgBB / Lightshot)" class="bg-slate-800 border border-slate-700 rounded px-3 py-2 text-sm">
              <button type="submit" class="bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold rounded py-2 text-sm">Submit Proof</button>
            </form>
          </div>
        <% }) %>
      </div>

      <!-- TAB 3: EMBEDDED SURVEY OFFERWALLS -->
      <div id="tab-offerwalls" class="tab-content hidden">
        <div class="bg-slate-800 border border-slate-700 p-5 rounded-xl">
          <h3 class="font-bold text-lg mb-2">External Survey & Offer Partners</h3>
          <p class="text-xs text-slate-400 mb-4">Replace the demo URL below with your approved Monlix, CPAlead, or BitLabs iFrame URL using <code>subid=<%= user.id %></code>.</p>
          <iframe src="https://fastsvr.com/list/528412?subid=<%= user.id %>" class="w-full h-[550px] rounded-lg border border-slate-700 bg-slate-950"></iframe>
        </div>
      </div>

      <!-- TAB 4: ADVERTISER PORTAL & PROOF APPROVAL -->
      <div id="tab-advertise" class="tab-content hidden grid md:grid-cols-2 gap-6">
        <div class="bg-slate-800 border border-slate-700 p-5 rounded-xl">
          <h3 class="font-bold text-lg mb-4 text-amber-400">Create New PTC Ad Campaign</h3>
          <form action="/api/advertiser/create-ptc" method="POST" class="space-y-3">
            <input type="text" name="title" required placeholder="Ad Headline" class="w-full bg-slate-900 border border-slate-700 rounded px-3 py-2 text-sm">
            <input type="url" name="url" required placeholder="Target Website URL (https://...)" class="w-full bg-slate-900 border border-slate-700 rounded px-3 py-2 text-sm">
            <div class="grid grid-cols-3 gap-2">
              <input type="number" name="timer_seconds" value="15" min="5" class="bg-slate-900 border border-slate-700 rounded px-3 py-2 text-sm" placeholder="Seconds">
              <input type="number" name="reward_points" value="20" min="5" class="bg-slate-900 border border-slate-700 rounded px-3 py-2 text-sm" placeholder="Pts/View">
              <input type="number" name="total_views" value="25" min="5" class="bg-slate-900 border border-slate-700 rounded px-3 py-2 text-sm" placeholder="Total Views">
            </div>
            <button type="submit" class="w-full bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold py-2 rounded text-sm">Launch Instant PTC Ad</button>
          </form>
        </div>

        <div class="bg-slate-800 border border-slate-700 p-5 rounded-xl">
          <h3 class="font-bold text-lg mb-4 text-emerald-400">Pending Micro-Task Proofs (<%= pendingAdmin.length %>)</h3>
          <div class="space-y-3 max-h-80 overflow-y-auto">
            <% pendingAdmin.forEach(item => { %>
              <div class="bg-slate-900 p-3 rounded border border-slate-700 text-xs">
                <div class="font-bold text-white"><%= item.title %> (+<%= item.reward_points %> pts)</div>
                <div class="text-slate-400 my-1">User: <%= item.email %> | Proof: <span class="text-amber-300"><%= item.proof_text %></span></div>
                <form action="/api/tasks/review" method="POST" class="flex gap-2 mt-2">
                  <input type="hidden" name="submission_id" value="<%= item.id %>">
                  <button name="action" value="approve" class="bg-emerald-600 px-3 py-1 rounded text-white font-bold">Approve</button>
                  <button name="action" value="reject" class="bg-rose-600 px-3 py-1 rounded text-white font-bold">Reject</button>
                </form>
              </div>
            <% }) %>
          </div>
        </div>
      </div>

      <!-- TAB 5: INSTANT WITHDRAWAL -->
      <div id="tab-withdraw" class="tab-content hidden max-w-md mx-auto">
        <div class="bg-slate-800 border border-slate-700 p-6 rounded-xl">
          <h3 class="font-bold text-xl mb-2 text-emerald-400">Instant FaucetPay Payout</h3>
          <p class="text-xs text-slate-400 mb-4">10,000 Points = $1.00 USDT. Minimum payout: 1,000 Points ($0.10 USDT).</p>
          <div class="space-y-3">
            <input type="text" id="fpAddress" value="<%= user.faucetpay_address %>" placeholder="FaucetPay Email or USDT Address" class="w-full bg-slate-900 border border-slate-700 rounded px-3 py-2 text-sm">
            <input type="number" id="withdrawPts" value="1000" min="1000" class="w-full bg-slate-900 border border-slate-700 rounded px-3 py-2 text-sm">
            <button onclick="withdrawFunds()" class="w-full bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold py-2.5 rounded-lg text-sm">Withdraw Instantly</button>
            <p id="withdrawMsg" class="text-xs text-center mt-2"></p>
          </div>
        </div>
      </div>

    <% } %>
  </main>

  <script>
    function showTab(name) {
      document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
      document.getElementById('tab-' + name).classList.remove('hidden');
    }

    let activeAdId = null;
    let timerInterval = null;

    async function startPtc(adId, url, seconds) {
      activeAdId = adId;
      await fetch('/api/ptc/start', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ adId })
      });

      window.open(url, '_blank');
      const box = document.getElementById('ptcTimerBox');
      const countEl = document.getElementById('ptcCountdown');
      const btn = document.getElementById('ptcClaimBtn');
      box.classList.remove('hidden');
      btn.classList.add('hidden');

      let remaining = seconds;
      countEl.innerText = remaining;
      clearInterval(timerInterval);

      timerInterval = setInterval(() => {
        remaining--;
        countEl.innerText = remaining;
        if (remaining <= 0) {
          clearInterval(timerInterval);
          btn.classList.remove('hidden');
        }
      }, 1000);
    }

    async function claimPtcReward() {
      const res = await fetch('/api/ptc/claim', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ adId: activeAdId })
      });
      const data = await res.json();
      if (data.success) {
        alert('Credited +' + data.reward + ' Points!');
        location.reload();
      } else {
        alert(data.error);
      }
    }

    async function withdrawFunds() {
      const pointsToWithdraw = document.getElementById('withdrawPts').value;
      const faucetpayAddress = document.getElementById('fpAddress').value;
      const msg = document.getElementById('withdrawMsg');
      msg.innerText = 'Processing payout...';

      const res = await fetch('/api/withdraw', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ pointsToWithdraw, faucetpayAddress })
      });
      const data = await res.json();
      msg.innerText = data.message || data.error;
      if (data.success) setTimeout(() => location.reload(), 1500);
    }
  </script>
</body>
</html>
